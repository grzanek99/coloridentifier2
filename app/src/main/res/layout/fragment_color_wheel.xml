<?xml version="1.0" encoding="utf-8"?>
<!-- layout dla fragmentu kola kolorow -->
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/padding_medium">

    <!-- widok niestandardowego kola kolorow -->
    <com.example.coloridentifier.ui.ColorWheelView
        android:id="@+id/colorWheelView"
        android:layout_width="@dimen/color_wheel_size"
        android:layout_height="@dimen/color_wheel_size"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- etykieta slidera jasnosci -->
    <TextView
        android:id="@+id/brightnessLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_medium"
        android:text="Adjust darkness to color intensity"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_size_medium"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/colorWheelView" />

    <!-- slider regulacji jasnosci koloru -->
    <com.google.android.material.slider.Slider
        android:id="@+id/brightnessSlider"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:valueFrom="0.0"
        android:valueTo="1.0"
        android:value="1.0"
        android:stepSize="0.01"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/brightnessLabel" />

    <!-- etykieta slotow kolorow -->
    <TextView
        android:id="@+id/slotsLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_large"
        android:text="@string/select_color_slot"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_size_medium"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/brightnessSlider" />

    <!-- przycisk dodania zapisanego koloru -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/addSavedColorButton"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add Saved Color"
        android:textSize="12sp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/slotsLabel"
        app:layout_constraintBottom_toBottomOf="@+id/slotsLabel" />

    <!-- kontener na sloty kolorow -->
    <LinearLayout
        android:id="@+id/colorSlotsContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_small"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/slotsLabel">

        <!-- kontener slotu koloru 1 -->
        <LinearLayout
            android:id="@+id/slot1Container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/spacing_small">

            <!-- widok slotu koloru 1 -->
            <View
                android:id="@+id/colorSlot1"
                android:layout_width="match_parent"
                android:layout_height="@dimen/color_slot_size"
                android:background="@color/gray_light" />

            <!-- etykieta slotu 1 -->
            <TextView
                android:id="@+id/slot1Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_tiny"
                android:text="1"
                android:textSize="@dimen/text_size_small" />
        </LinearLayout>

        <!-- kontener slotu koloru 2 -->
        <LinearLayout
            android:id="@+id/slot2Container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/spacing_small">

            <View
                android:id="@+id/colorSlot2"
                android:layout_width="match_parent"
                android:layout_height="@dimen/color_slot_size"
                android:background="@color/gray_light" />

            <TextView
                android:id="@+id/slot2Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_tiny"
                android:text="2"
                android:textSize="@dimen/text_size_small" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/slot3Container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/spacing_small">

            <View
                android:id="@+id/colorSlot3"
                android:layout_width="match_parent"
                android:layout_height="@dimen/color_slot_size"
                android:background="@color/gray_light" />

            <TextView
                android:id="@+id/slot3Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_tiny"
                android:text="3"
                android:textSize="@dimen/text_size_small" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/slot4Container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/spacing_small">

            <View
                android:id="@+id/colorSlot4"
                android:layout_width="match_parent"
                android:layout_height="@dimen/color_slot_size"
                android:background="@color/gray_light" />

            <TextView
                android:id="@+id/slot4Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_tiny"
                android:text="4"
                android:textSize="@dimen/text_size_small" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/slot5Container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/spacing_small">

            <View
                android:id="@+id/colorSlot5"
                android:layout_width="match_parent"
                android:layout_height="@dimen/color_slot_size"
                android:background="@color/gray_light" />

            <TextView
                android:id="@+id/slot5Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_tiny"
                android:text="5"
                android:textSize="@dimen/text_size_small" />
        </LinearLayout>

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/saveColorButton"
        style="@style/AppButton"
        android:layout_width="0dp"
        android:layout_marginTop="@dimen/spacing_medium"
        android:text="Save Color"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/colorSlotsContainer" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/savePaletteButton"
        style="@style/AppButton"
        android:layout_width="0dp"
        android:layout_marginTop="@dimen/spacing_small"
        android:text="@string/save_palette"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/saveColorButton" />

</androidx.constraintlayout.widget.ConstraintLayout>

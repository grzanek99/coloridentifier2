<?xml version="1.0" encoding="utf-8"?>
<!-- layout dla fragmentu wyboru koloru z obrazu -->
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/padding_medium">

    <!-- scrollview dla zawartosci obrazu i informacji -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/buttonsContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- kontener pionowy na elementy -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <!-- widok podgladu kamery -->
            <androidx.camera.view.PreviewView
                android:id="@+id/previewView"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:visibility="gone" />

            <!-- widok zaladowanego obrazu -->
            <ImageView
                android:id="@+id/imageView"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:scaleType="centerCrop"
                android:visibility="gone"
                tools:src="@android:drawable/ic_menu_gallery"
                tools:visibility="visible" />

            <!-- marker punktu dotyku na obrazie -->
            <View
                android:id="@+id/touchMarker"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="@drawable/touch_marker"
                android:visibility="gone" />

            <!-- karta z informacjami o wybranym kolorze -->
            <androidx.cardview.widget.CardView
                android:id="@+id/colorInfoCard"
                style="@style/AppCardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:visibility="gone"
                tools:visibility="visible">

                <!-- kontener na elementy informacji o kolorze -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <!-- podglad wybranego koloru -->
                    <View
                        android:id="@+id/colorPreview"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        tools:background="@color/primary" />

                    <!-- nazwa koloru -->
                    <TextView
                        android:id="@+id/colorName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:gravity="center"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="Red" />

                    <!-- wartosc hexadecymalna koloru -->
                    <TextView
                        android:id="@+id/colorHex"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_tiny"
                        android:gravity="center"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        tools:text="#FF0000" />

                    <!-- wartosci rgb koloru -->
                    <TextView
                        android:id="@+id/colorRgb"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_tiny"
                        android:gravity="center"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        tools:text="RGB(255, 0, 0)" />

                    <!-- kontener na przyciski akcji -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:orientation="horizontal">

                        <!-- przycisk zapisu koloru -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/saveColorButton"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="@string/save_color" />

                        <!-- przycisk kopiowania wszystkich danych -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/copyAllButton"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="Copy All" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- tekst instrukcji dla uzytkownika -->
            <TextView
                android:id="@+id/instructionText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:text="@string/tap_to_identify"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_medium"
                android:visibility="gone"
                tools:visibility="visible" />

        </LinearLayout>

    </ScrollView>

    <!-- kontener na przyciski glowne -->
    <LinearLayout
        android:id="@+id/buttonsContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- przycisk przechwycenia zdjecia z kamery -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCapturePhoto"
            style="@style/AppButton"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/spacing_small"
            android:text="Capture Photo"
            android:visibility="gone" />

        <!-- przycisk wyboru obrazu z galerii -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/chooseImageButton"
            style="@style/AppButton"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/spacing_small"
            android:text="@string/choose_image" />

        <!-- przycisk uruchomienia kamery -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/takePhotoButton"
            style="@style/AppButton"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/spacing_small"
            android:text="@string/take_photo" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
